# Optional. Without this the copilot runs in offline mode: a deterministic
# intent router plans the tool calls instead of a language model. All financial
# figures come from the tools either way, so behaviour is identical apart from
# phrasing - the demo, the tests and the evidence pack need no credential.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# AUDIT_LOG_PATH=logs/audit.jsonl
